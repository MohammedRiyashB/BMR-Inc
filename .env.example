# BMR Inc. Environment Variables

# Node Environment
NODE_ENV=production

# Server Port (Default is 3000)
PORT=3000

# Public Production URL (Canonical source of truth)
PUBLIC_SITE_URL=https://your-production-domain.com
VITE_PUBLIC_SITE_URL=https://your-production-domain.com

# Upstash Redis (Persistent Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-database-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-secure-token

# Brevo API Key (Server-side ONLY)
BREVO_API_KEY=

# Brevo Sender Information
BREVO_SENDER_EMAIL=support.bmrinc@gmail.com
BREVO_SENDER_NAME="BMR Inc."

# Contact Recipient
CONTACT_EMAIL=support.bmrinc@gmail.com
